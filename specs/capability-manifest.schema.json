{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-native-os.example/specs/capability-manifest.schema.json",
  "title": "AI-Native OS Capability Provider Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "publisher", "runtime", "provides"],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1"},
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]+$"
    },
    "version": {"type": "string", "minLength": 1},
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": ["string", "null"]},
        "source_url": {"type": ["string", "null"], "format": "uri"},
        "signature": {"type": ["string", "null"]}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["builtin", "process", "varlink", "oci", "model-adapter", "legacy-adapter", "remote"]
        },
        "entrypoint": {"type": ["string", "null"]},
        "interface": {"type": ["string", "null"]},
        "image": {"type": ["string", "null"]},
        "digest": {"type": ["string", "null"]}
      }
    },
    "provides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability", "version", "input_types", "output_types", "execution", "side_effects"],
        "properties": {
          "capability": {
            "type": "string",
            "pattern": "^[a-z0-9_.-]+$"
          },
          "version": {"type": "string", "minLength": 1},
          "input_types": {
            "type": "array",
            "items": {"type": "string"},
            "uniqueItems": true
          },
          "output_types": {
            "type": "array",
            "items": {"type": "string"},
            "uniqueItems": true
          },
          "side_effects": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["none", "read", "write", "network", "device", "external-communication", "system-change", "destructive"]
            },
            "uniqueItems": true
          },
          "execution": {
            "type": "object",
            "additionalProperties": false,
            "required": ["locality", "determinism", "minimum_isolation"],
            "properties": {
              "locality": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "enum": ["local", "peer", "remote"]},
                "uniqueItems": true
              },
              "determinism": {
                "type": "string",
                "enum": ["deterministic", "seeded", "probabilistic"]
              },
              "minimum_isolation": {
                "type": "string",
                "enum": ["P0", "P1", "P2", "P3", "P4", "P5"]
              },
              "network_default": {
                "type": "string",
                "enum": ["none", "allowlist", "internet"]
              }
            }
          },
          "authority": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "actions": {
                "type": "array",
                "items": {"type": "string"},
                "uniqueItems": true
              },
              "resource_classes": {
                "type": "array",
                "items": {"type": "string"},
                "uniqueItems": true
              }
            }
          },
          "resource_requirements": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "min_memory_bytes": {"type": ["integer", "null"], "minimum": 1},
              "preferred_accelerators": {
                "type": "array",
                "items": {"type": "string"},
                "uniqueItems": true
              },
              "requires_gpu": {"type": "boolean", "default": false}
            }
          },
          "conformance_suite": {"type": ["string", "null"]}
        }
      }
    },
    "trust": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_hash": {"type": ["string", "null"]},
        "build_provenance": {"type": ["string", "null"]},
        "review_status": {
          "type": ["string", "null"],
          "enum": [null, "unreviewed", "project-reviewed", "third-party-reviewed"]
        }
      }
    }
  }
}
