{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-native-os.example/specs/capability-manifest.schema.json",
  "title": "AI-Native OS Capability Provider Manifest",
  "description": "Provider implementation declaration. Semantic meaning comes from capability contracts; this manifest declares one implementation's runtime requirements/effect envelope and never grants Task authority.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "publisher", "runtime", "provides"],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]+$"},
    "version": {"type": "string", "minLength": 1},
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": ["string", "null"]},
        "source_url": {"type": ["string", "null"], "format": "uri"},
        "signature": {"type": ["string", "null"]}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"type": "string", "enum": ["builtin", "process", "varlink", "oci", "wasm", "model-adapter", "legacy-adapter", "remote"]},
        "entrypoint": {"type": ["string", "null"]},
        "interface": {"type": ["string", "null"]},
        "image": {"type": ["string", "null"]},
        "digest": {"type": ["string", "null"]}
      }
    },
    "provides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["contract", "conformance", "execution", "effect_classes"],
        "properties": {
          "contract": {
            "type": "object",
            "description": "Provider-independent semantic capability contract this implementation claims to satisfy.",
            "additionalProperties": false,
            "required": ["capability", "version", "contract_hash"],
            "properties": {
              "capability": {"type": "string", "pattern": "^[a-z0-9_.-]+$"},
              "version": {"type": "string", "minLength": 1},
              "contract_hash": {
                "type": ["string", "null"],
                "pattern": "^(?:[a-z0-9_-]+:[A-Fa-f0-9]+)?$",
                "description": "May be null only in bootstrap fixtures before the canonicalizer generates hashes."
              },
              "contract_source": {"type": ["string", "null"]}
            }
          },
          "conformance": {
            "type": "object",
            "additionalProperties": false,
            "required": ["suite", "status"],
            "properties": {
              "suite": {"type": "string", "minLength": 1},
              "suite_hash": {"type": ["string", "null"]},
              "status": {"type": "string", "enum": ["declared", "tested", "certified"]},
              "tested_at": {"type": ["string", "null"], "format": "date-time"},
              "test_environment": {"type": ["string", "null"]}
            }
          },
          "effect_classes": {
            "type": "array",
            "description": "Actual implementation/runtime effect envelope using canonical AIOS effect names. It must remain within the referenced semantic contract's allowed_effect_classes.",
            "minItems": 1,
            "items": {"$ref": "#/$defs/effectClass"},
            "uniqueItems": true
          },
          "execution": {
            "type": "object",
            "additionalProperties": false,
            "required": ["locality", "execution_class", "minimum_isolation"],
            "properties": {
              "locality": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "enum": ["local", "peer", "remote", "hybrid"]},
                "uniqueItems": true
              },
              "execution_class": {"type": "string", "enum": ["deterministic", "bounded_nondeterministic", "probabilistic", "opaque_external"]},
              "minimum_isolation": {"type": "string", "enum": ["P0", "P1", "P2", "P3", "P4", "P5"]},
              "network_default": {"type": "string", "enum": ["none", "allowlist", "internet"]}
            }
          },
          "authority": {
            "type": "object",
            "description": "Implementation-specific authority it may request at runtime; must be a subset of semantic contract allowed authority classes.",
            "additionalProperties": false,
            "properties": {
              "actions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
              "resource_classes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
            }
          },
          "representations": {
            "type": "object",
            "description": "Optional physical representation preferences for semantic ports; these do not redefine semantic types.",
            "additionalProperties": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
          },
          "resource_requirements": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "min_memory_bytes": {"type": ["integer", "null"], "minimum": 1},
              "preferred_accelerators": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
              "requires_gpu": {"type": "boolean", "default": false}
            }
          }
        }
      }
    },
    "trust": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_hash": {"type": ["string", "null"]},
        "build_provenance": {"type": ["string", "null"]},
        "review_status": {"type": ["string", "null"], "enum": [null, "unreviewed", "project-reviewed", "third-party-reviewed"]}
      }
    }
  },
  "$defs": {
    "effectClass": {
      "type": "string",
      "enum": ["PURE", "ARTIFACT_READ", "ARTIFACT_WRITE", "NETWORK", "DATA_EGRESS", "EXTERNAL_MESSAGE", "SECRET_ACCESS", "PERSISTENT_STATE", "DEVICE_ACCESS", "SYSTEM_CHANGE", "LEGACY_OPAQUE"]
    }
  }
}
