{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-native-os.example/specs/artifact-publication-result.schema.json",
  "title": "AIOS v0.1 Artifact Publication Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "publication_id",
    "allocation_id",
    "task_id",
    "published",
    "reason_code",
    "resulted_at"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1"},
    "publication_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "allocation_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "published": {"type": "boolean"},
    "reason_code": {"type": "string", "pattern": "^ARTIFACT_[A-Z0-9_]+$"},
    "message": {"type": ["string", "null"], "maxLength": 4096},
    "artifact_id": {"type": ["string", "null"], "maxLength": 512},
    "artifact_uri": {"type": ["string", "null"], "pattern": "^(?:artifact://.+)?$"},
    "semantic_type": {
      "type": ["string", "null"],
      "pattern": "^(?:[a-z][a-z0-9_.-]*@(?:0|[1-9][0-9]*))?$"
    },
    "media_type": {"type": ["string", "null"], "maxLength": 160},
    "size_bytes": {"type": ["integer", "null"], "minimum": 0},
    "content_hash": {
      "type": ["string", "null"],
      "pattern": "^(?:sha256:[a-f0-9]{64})?$"
    },
    "blob_reused": {"type": ["boolean", "null"]},
    "provenance_event_id": {"type": ["string", "null"], "maxLength": 256},
    "provenance_event_hash": {
      "type": ["string", "null"],
      "pattern": "^(?:sha256:[a-f0-9]{64})?$"
    },
    "resulted_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"published": {"const": true}}, "required": ["published"]},
      "then": {
        "required": [
          "artifact_id",
          "artifact_uri",
          "media_type",
          "size_bytes",
          "content_hash",
          "blob_reused",
          "provenance_event_id",
          "provenance_event_hash"
        ],
        "properties": {
          "artifact_id": {"type": "string", "minLength": 1},
          "artifact_uri": {"type": "string", "pattern": "^artifact://.+"},
          "media_type": {"type": "string", "minLength": 1},
          "size_bytes": {"type": "integer", "minimum": 0},
          "content_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
          "blob_reused": {"type": "boolean"},
          "provenance_event_id": {"type": "string", "minLength": 1},
          "provenance_event_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
        }
      }
    }
  ]
}
