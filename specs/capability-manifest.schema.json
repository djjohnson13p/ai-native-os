{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/aios/capability-manifest.schema.json",
  "title": "AI-Native OS Capability Provider Manifest",
  "type": "object",
  "required": ["id", "version", "provides"],
  "properties": {
    "id": {"type": "string", "minLength": 3},
    "version": {"type": "string", "minLength": 1},
    "publisher": {"type": "string"},
    "provides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["capability"],
        "properties": {
          "capability": {"type": "string", "pattern": "^[a-z0-9_.-]+$"},
          "input_types": {"type": "array", "items": {"type": "string"}},
          "output_types": {"type": "array", "items": {"type": "string"}},
          "execution": {
            "type": "object",
            "properties": {
              "locality": {"enum": ["local", "peer", "remote", "hybrid", "any"]},
              "deterministic": {"type": "boolean"},
              "sandbox": {"type": "string"}
            },
            "additionalProperties": true
          },
          "authority": {
            "type": "object",
            "properties": {
              "requires": {"type": "array", "items": {"type": "string"}}
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
