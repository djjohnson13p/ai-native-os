{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-native-os.example/specs/policy-decision.schema.json",
  "title": "Policy Decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision_id", "task_id", "principal", "request", "decision", "decided_at", "policy_version"],
  "properties": {
    "decision_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "principal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["user", "system-service", "agent", "provider", "model-provider", "legacy-app", "peer-node"]
        },
        "id": {"type": "string", "minLength": 1}
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability", "actions", "resources"],
      "properties": {
        "capability": {"type": "string", "minLength": 1},
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "resources": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "constraints": {
          "type": "object",
          "additionalProperties": true
        },
        "impact_level": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 4
        }
      }
    },
    "decision": {
      "type": "string",
      "enum": ["allow", "deny", "require-approval", "allow-with-narrower-scope"]
    },
    "effective_scope": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "actions": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "resources": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "constraints": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z0-9_.-]+$"
      },
      "uniqueItems": true
    },
    "human_explanation": {"type": ["string", "null"]},
    "approval_request_id": {"type": ["string", "null"]},
    "policy_version": {"type": "string", "minLength": 1},
    "decided_at": {"type": "string", "format": "date-time"}
  }
}
