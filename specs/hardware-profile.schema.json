{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/aios/hardware-profile.schema.json",
  "title": "AI-Native OS Hardware Profile",
  "type": "object",
  "required": ["architecture", "memory"],
  "properties": {
    "architecture": {"type": "string"},
    "cpu": {"type": "object"},
    "memory": {
      "type": "object",
      "required": ["total_bytes"],
      "properties": {
        "total_bytes": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": true
    },
    "accelerators": {"type": "array", "items": {"type": "object"}},
    "storage": {"type": "array", "items": {"type": "object"}},
    "network": {"type": "object"},
    "power": {"type": "object"},
    "security": {"type": "object"},
    "peer_compute": {"type": "array", "items": {"type": "object"}}
  },
  "additionalProperties": true
}
