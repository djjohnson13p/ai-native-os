{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-native-os.example/specs/capability-token.schema.json",
  "title": "AIOS v0.1 Opaque Capability Token Handle",
  "description": "Metadata/reference for an opaque runtime token whose authoritative scope is stored in authority-grant-record. This schema never embeds grants, secrets, or bearer token material.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "token_id", "grant_id", "task_id", "principal", "state", "issued_at", "expires_at"],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1"},
    "token_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "grant_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "principal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {"type": "string", "enum": ["agent", "provider", "legacy-app", "system-service", "peer-node"]},
        "id": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "execution_binding_id": {"type": ["string", "null"], "maxLength": 256},
    "state": {"type": "string", "enum": ["ACTIVE", "CONSUMED", "EXPIRED", "REVOKED"]},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "opaque_token_material_present": {
      "type": "boolean",
      "const": false,
      "description": "Persisted schema intentionally excludes the actual bearer/opaque token bytes. Runtime delivery is out-of-band."
    }
  }
}
