{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-native-os.example/specs/protected-operation-context.schema.json",
  "title": "AIOS v0.1 Protected Operation Context",
  "description": "Trusted point-of-use context for a protected broker/resource operation. Fields received from an untrusted caller are claims until matched against authenticated channel and durable binding/grant state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation_id",
    "task_id",
    "semantic_program_hash",
    "node_id",
    "execution_binding_id",
    "attempt_id",
    "effective_principal",
    "action",
    "resource",
    "grant_refs",
    "requested_at"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1"},
    "operation_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "semantic_program_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "node_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "execution_binding_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "attempt_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "effective_principal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {"type": "string", "enum": ["agent", "provider", "legacy-app", "system-service", "peer-node"]},
        "id": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "authenticated_channel_principal": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "kind": {"type": "string", "enum": ["agent", "provider", "legacy-app", "system-service", "peer-node"]},
        "id": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "action": {"type": "string", "minLength": 3, "maxLength": 128, "pattern": "^[a-z][a-z0-9_.:-]*$"},
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {"type": "string", "enum": ["artifact", "output-allocation", "object", "service", "credential", "device", "system-resource", "external-destination", "other"]},
        "id": {"type": "string", "minLength": 1, "maxLength": 1024},
        "revision": {"type": ["integer", "null"], "minimum": 0},
        "content_hash": {"type": ["string", "null"], "maxLength": 256}
      }
    },
    "grant_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 512}
    },
    "semantic_selector": {"type": ["string", "null"], "maxLength": 512},
    "requested_at": {"type": "string", "format": "date-time"},
    "idempotency_key": {"type": ["string", "null"], "maxLength": 512}
  }
}
