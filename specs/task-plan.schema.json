{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-native-os.example/specs/task-plan.schema.json",
  "title": "AI-Native OS Task Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "task_id", "revision", "intent", "nodes"],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1"},
    "plan_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "intent": {"type": "string", "minLength": 1},
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "privacy": {
          "type": "string",
          "enum": ["local-only", "local-first", "remote-allowed"]
        },
        "max_cost_microunits": {"type": ["integer", "null"], "minimum": 0},
        "deadline": {"type": ["string", "null"], "format": "date-time"},
        "preserve_inputs": {"type": "boolean", "default": true},
        "portable_outputs": {"type": "boolean", "default": true}
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "capability", "depends_on", "inputs", "outputs"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+$"
          },
          "capability": {
            "type": "string",
            "pattern": "^[a-z0-9_.-]+$"
          },
          "capability_version": {"type": ["string", "null"]},
          "depends_on": {
            "type": "array",
            "items": {"type": "string"},
            "uniqueItems": true
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "ref"],
              "properties": {
                "name": {"type": "string", "minLength": 1},
                "ref": {"type": "string", "minLength": 1},
                "type": {"type": ["string", "null"]}
              }
            }
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "type"],
              "properties": {
                "name": {"type": "string", "minLength": 1},
                "type": {"type": "string", "minLength": 1},
                "artifact": {"type": "boolean", "default": true}
              }
            }
          },
          "authority_requests": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["actions", "resources"],
              "properties": {
                "actions": {
                  "type": "array",
                  "minItems": 1,
                  "items": {"type": "string"},
                  "uniqueItems": true
                },
                "resources": {
                  "type": "array",
                  "minItems": 1,
                  "items": {"type": "string"},
                  "uniqueItems": true
                },
                "reason": {"type": ["string", "null"]}
              }
            }
          },
          "verification": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "required": {"type": "boolean", "default": false},
              "capability": {"type": ["string", "null"]},
              "independent_provider": {"type": "boolean", "default": false}
            }
          },
          "placement": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "locality": {
                "type": "string",
                "enum": ["local", "peer", "remote", "any"]
              },
              "isolation_min": {
                "type": ["string", "null"],
                "enum": [null, "P0", "P1", "P2", "P3", "P4", "P5"]
              }
            }
          }
        }
      }
    },
    "created_at": {"type": ["string", "null"], "format": "date-time"},
    "planner": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "provider_id": {"type": ["string", "null"]},
        "model_id": {"type": ["string", "null"]},
        "deterministic": {"type": "boolean", "default": false}
      }
    }
  }
}
