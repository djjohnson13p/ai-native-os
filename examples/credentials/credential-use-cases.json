[
  {
    "name": "non-exportable-private-key-signs-through-broker",
    "expected": "ALLOWED_AND_USED",
    "reason_code": "CRED_ALLOWED",
    "facts": {
      "credential_class": "PRIVATE_KEY",
      "exportability": "NON_EXPORTABLE",
      "use_mode": "BROKERED_OPERATION",
      "action": "crypto.sign",
      "secret_exposed_to_provider": false
    }
  },
  {
    "name": "non-exportable-private-key-export-attempt",
    "expected": "EXPORT_NOT_ALLOWED",
    "reason_code": "CRED_EXPORT_NOT_ALLOWED",
    "facts": {
      "credential_class": "PRIVATE_KEY",
      "exportability": "NON_EXPORTABLE",
      "use_mode": "EXPORT_WITH_APPROVAL",
      "approval_present": true
    }
  },
  {
    "name": "local-restricted-secret-cannot-follow-remote-placement",
    "expected": "EXPORT_NOT_ALLOWED",
    "reason_code": "CRED_EXPORT_NOT_ALLOWED",
    "facts": {
      "exportability": "LOCAL_EXPORT_RESTRICTED",
      "placement": "remote"
    }
  },
  {
    "name": "credential-handle-without-authority",
    "expected": "AUTHORITY_DENIED",
    "reason_code": "CRED_AUTHORITY_DENIED",
    "facts": {
      "handle_valid": true,
      "authority_grant_present": false
    }
  },
  {
    "name": "wrong-provider-cannot-use-credential-grant",
    "expected": "PROVIDER_BINDING_MISMATCH",
    "reason_code": "CRED_PROVIDER_BINDING_MISMATCH",
    "facts": {
      "authorized_provider": "provider-A",
      "caller_provider": "provider-B"
    }
  },
  {
    "name": "scope-escalation-blocked",
    "expected": "SCOPE_MISMATCH",
    "reason_code": "CRED_SCOPE_MISMATCH",
    "facts": {
      "credential_scopes": ["mail.send"],
      "requested_scopes": ["mail.send", "mail.read.all"]
    }
  },
  {
    "name": "service-mismatch-blocked",
    "expected": "SERVICE_MISMATCH",
    "reason_code": "CRED_SERVICE_MISMATCH",
    "facts": {
      "credential_service": "service://mail/fixture",
      "requested_service": "service://storage/fixture"
    }
  },
  {
    "name": "revoked-handle-blocked-at-point-of-use",
    "expected": "HANDLE_INACTIVE",
    "reason_code": "CRED_REVOKED",
    "facts": {
      "handle_status": "REVOKED"
    }
  },
  {
    "name": "secure-store-outage-fails-closed",
    "expected": "SECURE_STORE_UNAVAILABLE",
    "reason_code": "CRED_SECURE_STORE_UNAVAILABLE",
    "facts": {
      "secure_store_available": false
    }
  },
  {
    "name": "exportable-secret-still-needs-exact-approval",
    "expected": "AUTHORITY_DENIED",
    "reason_code": "CRED_APPROVAL_REQUIRED",
    "facts": {
      "exportability": "EXPORTABLE_WITH_APPROVAL",
      "use_mode": "EXPORT_WITH_APPROVAL",
      "approval_present": false
    }
  },
  {
    "name": "approval-invalid-after-destination-change",
    "expected": "AUTHORITY_DENIED",
    "reason_code": "CRED_APPROVAL_STALE",
    "facts": {
      "approved_destination": "service://api/A",
      "requested_destination": "service://api/B"
    }
  },
  {
    "name": "delegated-token-narrower-than-source",
    "expected": "ALLOWED_AND_USED",
    "reason_code": "CRED_ALLOWED",
    "facts": {
      "source_scopes": ["mail.read", "mail.send", "contacts.read"],
      "delegated_scopes": ["mail.send"],
      "source_expiry_seconds": 3600,
      "delegated_expiry_seconds": 300,
      "secret_exposed_to_provider": false
    }
  }
]
