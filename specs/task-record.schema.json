{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-native-os.example/specs/task-record.schema.json",
  "title": "Persisted Task Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "revision",
    "state",
    "principal",
    "original_intent",
    "input_artifacts",
    "output_artifacts",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1"},
    "task_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "state": {
      "type": "string",
      "enum": [
        "CREATED",
        "PLANNING",
        "WAITING_FOR_INPUT",
        "WAITING_FOR_AUTH",
        "RUNNABLE",
        "RUNNING",
        "VERIFYING",
        "PAUSED",
        "RECOVERING",
        "ROLLING_BACK",
        "COMPLETED",
        "FAILED",
        "CANCELLED",
        "ROLLED_BACK"
      ]
    },
    "state_reason": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "code": {"type": ["string", "null"]},
        "message": {"type": ["string", "null"]},
        "provenance_event_id": {"type": ["string", "null"]}
      }
    },
    "principal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {"type": "string", "enum": ["user", "system-service"]},
        "id": {"type": "string", "minLength": 1}
      }
    },
    "workspace_id": {"type": ["string", "null"]},
    "original_intent": {"type": "string", "minLength": 1},
    "normalized_intent": {
      "type": ["object", "null"],
      "additionalProperties": true
    },
    "input_artifacts": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "output_artifacts": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "active_plan": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["plan_id", "revision"],
      "properties": {
        "plan_id": {"type": "string", "minLength": 1},
        "revision": {"type": "integer", "minimum": 1}
      }
    },
    "active_program": {
      "type": ["object", "null"],
      "description": "Validated semantic AIOS IR program selected for execution. Runtime provider/grant bindings are stored separately.",
      "additionalProperties": false,
      "required": ["ir_version", "program_id", "semantic_hash", "registry_snapshot_id"],
      "properties": {
        "ir_version": {"type": "string", "minLength": 1},
        "program_id": {"type": "string", "minLength": 1},
        "semantic_hash": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+:[A-Fa-f0-9]+$"
        },
        "registry_snapshot_id": {"type": "string", "minLength": 1},
        "validation_result_id": {"type": ["string", "null"]},
        "validated_at": {"type": ["string", "null"], "format": "date-time"},
        "validator_id": {"type": ["string", "null"]},
        "validator_version": {"type": ["string", "null"]}
      }
    },
    "active_step_ids": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "active_execution_binding_ids": {
      "type": "array",
      "description": "Attempt-specific runtime bindings currently active. These do not define semantic program identity.",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "waiting_on": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "id"],
        "properties": {
          "kind": {"type": "string", "enum": ["input", "approval", "resource", "provider", "validation"]},
          "id": {"type": "string", "minLength": 1},
          "message": {"type": ["string", "null"]}
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "privacy": {"type": "string", "enum": ["local-only", "local-first", "remote-allowed"]},
        "max_cost_microunits": {"type": ["integer", "null"], "minimum": 0},
        "deadline": {"type": ["string", "null"], "format": "date-time"},
        "preserve_inputs": {"type": "boolean", "default": true}
      }
    },
    "failure": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "code": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Z][A-Z0-9_]*$"},
        "summary": {"type": "string"},
        "step_id": {"type": ["string", "null"]},
        "provider_id": {"type": ["string", "null"]},
        "execution_binding_id": {"type": ["string", "null"]},
        "retryable": {"type": "boolean"},
        "safe_to_replan": {"type": "boolean"},
        "unknown_side_effects": {"type": "boolean"},
        "rollback_available": {"type": "boolean"},
        "provenance_event_ids": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        }
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "last_reconciled_at": {"type": ["string", "null"], "format": "date-time"},
        "last_known_daemon_instance": {"type": ["string", "null"]},
        "unknown_operation_ids": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "unknown_operations_ref": {"type": ["string", "null"]}
      }
    },
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": ["string", "null"], "format": "date-time"}
  }
}
