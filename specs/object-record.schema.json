{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-native-os.example/specs/object-record.schema.json",
  "title": "AIOS Semantic Object Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "object_id", "semantic_type", "semantic_version", "revision", "source_state", "created_at", "updated_at"],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1"},
    "object_id": {"type": "string", "pattern": "^object://"},
    "semantic_type": {"type": "string", "minLength": 1},
    "semantic_version": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "source_state": {
      "type": "string",
      "enum": ["native", "federated", "mirrored", "derived", "ephemeral"]
    },
    "source_of_truth": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "provider_id": {"type": ["string", "null"]},
        "external_system": {"type": ["string", "null"]},
        "external_id": {"type": ["string", "null"]},
        "expected_version": {"type": ["string", "null"]}
      }
    },
    "owner": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "kind": {"type": "string", "enum": ["user", "organization", "system-service"]},
        "id": {"type": "string", "minLength": 1}
      }
    },
    "sensitivity": {
      "type": "string",
      "enum": ["public", "local", "private", "confidential", "secret"]
    },
    "labels": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["predicate", "target"],
        "properties": {
          "predicate": {"type": "string", "minLength": 1},
          "target": {"type": "string", "pattern": "^object://"},
          "metadata": {"type": "object", "additionalProperties": true}
        }
      }
    },
    "representations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "role"],
        "properties": {
          "artifact_id": {"type": "string", "minLength": 1},
          "role": {"type": "string", "enum": ["native", "portable", "preview", "source", "derived", "archive"]},
          "semantic_equivalence": {"type": "string", "enum": ["authoritative", "lossless", "lossy", "view-only", "unknown"]}
        }
      }
    },
    "attributes": {
      "type": "object",
      "additionalProperties": true
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "created_by_task": {"type": ["string", "null"]},
        "last_modified_by_task": {"type": ["string", "null"]},
        "provenance_event_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "class": {"type": "string", "enum": ["ephemeral", "task", "persistent", "user-managed", "external-system-managed"]},
        "expires_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
