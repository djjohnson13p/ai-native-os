{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-native-os.example/specs/provider-conformance-result.schema.json",
  "title": "AIOS Provider Conformance Result",
  "description": "Machine-readable evidence that one provider implementation/build was tested against one exact semantic capability contract and conformance suite.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result_id",
    "provider_id",
    "provider_version",
    "provider_build_identity",
    "semantic_capability_ref",
    "semantic_contract_version",
    "semantic_contract_hash",
    "conformance_suite",
    "harness",
    "result",
    "executed_at"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1"},
    "result_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "provider_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "provider_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "provider_build_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": {"type": "string", "enum": ["package_digest", "build_hash", "component_digest", "other"]},
        "value": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "semantic_capability_ref": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*@(?:0|[1-9][0-9]*)$"
    },
    "semantic_contract_version": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:\\.(?:0|[1-9][0-9]*))?$"
    },
    "semantic_contract_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "conformance_suite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "hash"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 256},
        "version": {"type": "string", "minLength": 1, "maxLength": 128},
        "hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 256},
        "version": {"type": "string", "minLength": 1, "maxLength": 128},
        "build_hash": {"type": ["string", "null"], "maxLength": 256}
      }
    },
    "environment_profile_ref": {"type": ["string", "null"], "maxLength": 512},
    "result": {"type": "string", "enum": ["pass", "fail", "partial", "error"]},
    "tests_total": {"type": ["integer", "null"], "minimum": 0},
    "tests_passed": {"type": ["integer", "null"], "minimum": 0},
    "tests_failed": {"type": ["integer", "null"], "minimum": 0},
    "diagnostic_artifact_ids": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 512}
    },
    "executed_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": ["string", "null"], "format": "date-time"},
    "notes": {"type": ["string", "null"], "maxLength": 4096}
  }
}
