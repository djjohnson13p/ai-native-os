{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-native-os.example/specs/registry-snapshot.schema.json",
  "title": "AIOS Semantic Registry Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_id",
    "type_contracts",
    "capability_contracts",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "Content-addressed snapshot identity once generated by the canonicalizer."
    },
    "generation": {
      "type": ["string", "null"],
      "maxLength": 128
    },
    "type_contracts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/contractRef"
      }
    },
    "capability_contracts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/contractRef"
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "publisher": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "signature": {
          "type": ["string", "null"]
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 2048
      }
    }
  },
  "$defs": {
    "contractRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "content_hash"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+:[A-Fa-f0-9]+$"
        },
        "source": {
          "type": ["string", "null"],
          "maxLength": 1024
        }
      }
    }
  }
}
