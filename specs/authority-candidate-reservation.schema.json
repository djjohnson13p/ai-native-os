{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-native-os.example/specs/authority-candidate-reservation.schema.json",
  "title": "AIOS v0.1 Pending Authority Candidate Reservation",
  "description": "Trusted non-executable pre-policy reservation. Finalization must revalidate and atomically create grants and an immutable Execution Binding.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_id", "binding_id", "attempt_id", "task_id", "semantic_program_hash", "registry_snapshot_id", "ir_version", "node_id", "capability", "capability_contract_hash", "provider_registration_id", "provider_id", "provider_version", "provider_manifest_hash", "provider_build_hash", "conformance_evidence_id", "provider_trust_source_id", "execution_profile_ref", "isolation_class", "placement_locality", "attempt_number", "resources", "status", "created_at"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "candidate_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "binding_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "attempt_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "semantic_program_hash": {"$ref": "#/$defs/hash"},
    "registry_snapshot_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "ir_version": {"const": "0.1"},
    "node_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "capability": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*@(?:0|[1-9][0-9]*)$"},
    "capability_contract_hash": {"$ref": "#/$defs/hash"},
    "provider_registration_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "provider_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "provider_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "provider_manifest_hash": {"$ref": "#/$defs/hash"},
    "provider_build_hash": {"$ref": "#/$defs/hash"},
    "conformance_evidence_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "provider_trust_source_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "execution_profile_ref": {"type": "string", "minLength": 1, "maxLength": 512},
    "isolation_class": {"enum": ["P0", "P1", "P2", "P3", "P4", "P5"]},
    "placement_locality": {"const": "local"},
    "attempt_number": {"type": "integer", "minimum": 1, "maximum": 100},
    "resources": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/resource"}},
    "status": {"type": "object", "additionalProperties": false, "required": ["revision", "state", "updated_at"], "properties": {"revision": {"const": 1}, "state": {"const": "PENDING"}, "updated_at": {"type": "string", "format": "date-time"}}},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "resource": {
      "type": "object", "additionalProperties": false,
      "required": ["action", "semantic_selector", "resource_kind", "resource_id", "expected_semantic_type"],
      "properties": {
        "action": {"type": "string", "minLength": 3, "maxLength": 128},
        "semantic_selector": {"type": "string", "minLength": 3, "maxLength": 512},
        "resource_kind": {"enum": ["artifact", "output-allocation"]},
        "resource_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "output_port": {"type": "string", "minLength": 1, "maxLength": 128},
        "expected_semantic_type": {"type": "string", "minLength": 5, "maxLength": 128}
      },
      "allOf": [
        {"if": {"properties": {"resource_kind": {"const": "artifact"}}}, "then": {"not": {"required": ["output_port"]}}},
        {"if": {"properties": {"resource_kind": {"const": "output-allocation"}}}, "then": {"required": ["output_port"]}}
      ]
    }
  }
}
