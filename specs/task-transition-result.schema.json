{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-native-os.example/specs/task-transition-result.schema.json",
  "title": "AIOS v0.1 Task Transition Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "transition_id",
    "task_id",
    "applied",
    "reason_code",
    "observed_state",
    "observed_revision",
    "resulted_at"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1"},
    "transition_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "applied": {"type": "boolean"},
    "reason_code": {"type": "string", "pattern": "^TASK_[A-Z0-9_]+$"},
    "message": {"type": ["string", "null"], "maxLength": 4096},
    "previous_state": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/taskState"}]},
    "current_state": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/taskState"}]},
    "previous_revision": {"type": ["integer", "null"], "minimum": 1},
    "current_revision": {"type": ["integer", "null"], "minimum": 1},
    "observed_state": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/taskState"}]},
    "observed_revision": {"type": ["integer", "null"], "minimum": 1},
    "provenance_event_id": {"type": ["string", "null"], "maxLength": 256},
    "provenance_event_hash": {
      "type": ["string", "null"],
      "pattern": "^(?:sha256:[a-f0-9]{64})?$"
    },
    "resulted_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"applied": {"const": true}}, "required": ["applied"]},
      "then": {
        "required": [
          "previous_state",
          "current_state",
          "previous_revision",
          "current_revision",
          "provenance_event_id",
          "provenance_event_hash"
        ],
        "properties": {
          "previous_state": {"$ref": "#/$defs/taskState"},
          "current_state": {"$ref": "#/$defs/taskState"},
          "previous_revision": {"type": "integer", "minimum": 1},
          "current_revision": {"type": "integer", "minimum": 2},
          "provenance_event_id": {"type": "string", "minLength": 1},
          "provenance_event_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
        }
      }
    },
    {
      "if": {
        "properties": {"reason_code": {"const": "TASK_NOT_FOUND"}},
        "required": ["reason_code"]
      },
      "then": {
        "properties": {
          "applied": {"const": false},
          "observed_state": {"type": "null"},
          "observed_revision": {"type": "null"}
        }
      },
      "else": {
        "if": {
          "properties": {"reason_code": {"const": "TASK_TRANSITION_ID_REUSE_CONFLICT"}},
          "required": ["reason_code"]
        },
        "then": {
          "properties": {"applied": {"const": false}},
          "anyOf": [
            {
              "properties": {
                "observed_state": {"type": "null"},
                "observed_revision": {"type": "null"}
              }
            },
            {
              "properties": {
                "observed_state": {"$ref": "#/$defs/taskState"},
                "observed_revision": {"type": "integer", "minimum": 1}
              }
            }
          ]
        },
        "else": {
          "properties": {
            "observed_state": {"$ref": "#/$defs/taskState"},
            "observed_revision": {"type": "integer", "minimum": 1}
          }
        }
      }
    }
  ],
  "$defs": {
    "taskState": {
      "type": "string",
      "enum": [
        "CREATED",
        "PLANNING",
        "WAITING_FOR_INPUT",
        "WAITING_FOR_AUTH",
        "RUNNABLE",
        "RUNNING",
        "VERIFYING",
        "PAUSED",
        "RECOVERING",
        "ROLLING_BACK",
        "COMPLETED",
        "FAILED",
        "CANCELLED",
        "ROLLED_BACK"
      ]
    }
  }
}
