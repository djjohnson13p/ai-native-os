{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-native-os.example/specs/execution-binding.schema.json",
  "title": "AI-Native OS Execution Binding",
  "description": "Concrete attempt-specific binding of one validated AIOS IR node to provider, resources, authority, and placement. This is not semantic IR.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "binding_id",
    "task_id",
    "program_hash",
    "ir_version",
    "node_id",
    "capability",
    "provider",
    "inputs",
    "outputs",
    "policy_decision_id",
    "authority",
    "execution_profile",
    "placement",
    "attempt"
  ],
  "properties": {
    "binding_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "program_hash": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+:[A-Fa-f0-9]+$"
    },
    "ir_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "node_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "capability": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160
    },
    "capability_contract_hash": {
      "type": ["string", "null"],
      "maxLength": 256
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "manifest_hash": {
          "type": ["string", "null"],
          "maxLength": 256
        },
        "conformance_status": {
          "type": ["string", "null"],
          "enum": [null, "declared", "tested", "certified"]
        }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_or_value_ref"],
        "properties": {
          "artifact_or_value_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "content_hash": {
            "type": ["string", "null"],
            "maxLength": 256
          }
        }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["allocation_ref"],
        "properties": {
          "allocation_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        }
      }
    },
    "policy_decision_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grant_refs"],
      "properties": {
        "grant_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "expires_at": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      }
    },
    "execution_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_ref"],
      "properties": {
        "profile_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "profile_hash": {
          "type": ["string", "null"],
          "maxLength": 256
        }
      }
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locality"],
      "properties": {
        "locality": {
          "type": "string",
          "enum": ["local", "peer", "remote", "hybrid"]
        },
        "hardware_profile_ref": {
          "type": ["string", "null"],
          "maxLength": 512
        },
        "device_class": {
          "type": ["string", "null"],
          "maxLength": 160
        },
        "remote_endpoint_class": {
          "type": ["string", "null"],
          "maxLength": 160
        }
      }
    },
    "model_descriptor_ref": {
      "type": ["string", "null"],
      "maxLength": 512
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "created_at": {
      "type": ["string", "null"],
      "format": "date-time"
    }
  }
}
