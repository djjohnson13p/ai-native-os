{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-native-os.example/specs/credential-handle.schema.json",
  "title": "AIOS Credential Handle",
  "description": "Metadata/handle for mediated credential use. This schema must not carry raw secret material.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "handle_id", "credential_class", "owner_principal_id", "storage_boundary", "exportability", "status", "created_at"],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1"},
    "handle_id": {"type": "string", "pattern": "^credential://", "maxLength": 1024},
    "credential_class": {"type": "string", "enum": ["PRIVATE_KEY", "CERTIFICATE", "OAUTH_TOKEN_SET", "API_CREDENTIAL", "PASSWORD_REFERENCE", "DATABASE_CREDENTIAL", "SSH_CREDENTIAL", "DEVICE_KEY", "ORGANIZATION_SERVICE_IDENTITY", "SECRET_REFERENCE"]},
    "owner_principal_id": {"type": "string", "minLength": 1, "maxLength": 512},
    "issuer_or_service_id": {"type": ["string", "null"], "maxLength": 512},
    "scopes": {"type": "array", "items": {"type": "string", "maxLength": 512}, "uniqueItems": true},
    "resource_constraints": {"type": "array", "items": {"type": "string", "maxLength": 1024}, "uniqueItems": true},
    "storage_boundary": {"type": "string", "enum": ["LOCAL_SECURE_STORE", "HARDWARE_BACKED", "ORGANIZATION_SECRET_STORE", "REMOTE_SECRET_BROKER", "PROVIDER_MANAGED_REFERENCE"]},
    "exportability": {"type": "string", "enum": ["NON_EXPORTABLE", "LOCAL_EXPORT_RESTRICTED", "DELEGABLE_HANDLE_ONLY", "EXPORTABLE_WITH_APPROVAL"]},
    "status": {"type": "string", "enum": ["ACTIVE", "ROTATING", "REVOKED", "EXPIRED", "LOCKED", "UNAVAILABLE"]},
    "delegation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "delegable": {"type": "boolean", "default": false},
        "max_depth": {"type": "integer", "minimum": 0, "maximum": 8},
        "allowed_principal_kinds": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "not_before": {"type": ["string", "null"], "format": "date-time"},
    "expires_at": {"type": ["string", "null"], "format": "date-time"},
    "last_used_at": {"type": ["string", "null"], "format": "date-time"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": ["string", "null"], "format": "date-time"}
  }
}
