{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-native-os.example/specs/credential-use-request.schema.json",
  "title": "AIOS v0.1 Credential Use Request",
  "description": "Concrete request to use an opaque credential handle under a current Authority Grant. Contains no raw secret material.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "task_id",
    "semantic_program_hash",
    "node_id",
    "capability",
    "principal",
    "execution_binding_id",
    "authority_grant_id",
    "credential_handle_id",
    "operation",
    "use_mode",
    "requested_at"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1"},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "semantic_program_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "node_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "capability": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*@(?:0|[1-9][0-9]*)$"},
    "principal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {"type": "string", "enum": ["provider", "legacy-app", "system-service", "agent", "peer-node"]},
        "id": {"type": "string", "minLength": 1, "maxLength": 256},
        "version": {"type": ["string", "null"], "maxLength": 128}
      }
    },
    "execution_binding_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "attempt_id": {"type": ["string", "null"], "maxLength": 256},
    "authority_grant_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "credential_handle_id": {"type": "string", "pattern": "^credential://", "maxLength": 1024},
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action"],
      "properties": {
        "action": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]*$", "maxLength": 128},
        "service_id": {"type": ["string", "null"], "maxLength": 512},
        "resource_scope": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "maxLength": 1024}},
        "requested_scopes": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "maxLength": 512}},
        "destination_class": {"type": ["string", "null"], "maxLength": 128}
      }
    },
    "use_mode": {
      "type": "string",
      "enum": ["BROKERED_OPERATION", "DELEGATED_SHORT_LIVED", "LOCAL_INJECTION_RESTRICTED", "EXPORT_WITH_APPROVAL"]
    },
    "placement": {"type": "string", "enum": ["local", "peer", "remote", "hybrid"]},
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expires_after_seconds": {"type": ["integer", "null"], "minimum": 1, "maximum": 86400},
        "max_uses": {"type": ["integer", "null"], "minimum": 1, "maximum": 1000000},
        "max_cost_microusd": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "approval_id": {"type": ["string", "null"], "maxLength": 256},
    "requested_at": {"type": "string", "format": "date-time"}
  }
}
