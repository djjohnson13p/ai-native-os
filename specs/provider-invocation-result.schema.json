{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-native-os.example/specs/provider-invocation-result.schema.json",
  "title": "AIOS v0.1 Provider Invocation Result",
  "description": "Structured result collected by the Provider Supervisor for one invocation attempt. Process exit/logs are diagnostic inputs, not this semantic record by themselves.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result_id",
    "invocation_id",
    "task_id",
    "execution_binding_id",
    "node_id",
    "provider",
    "status",
    "reason_codes",
    "outputs",
    "started_at",
    "completed_at"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1"},
    "result_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "invocation_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "execution_binding_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "node_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 256},
        "version": {"type": "string", "minLength": 1, "maxLength": 128},
        "package_or_build_hash": {"type": ["string", "null"], "maxLength": 256}
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "SUCCEEDED",
        "SEMANTIC_FAILURE",
        "PROVIDER_FAILURE",
        "START_FAILED",
        "TIMED_OUT",
        "CANCELLED",
        "OUTPUT_FINALIZATION_FAILED",
        "AUTHORITY_REVOKED",
        "OUTCOME_UNKNOWN"
      ]
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^PROVIDER_[A-Z0-9_]+$", "maxLength": 128}
    },
    "semantic_error": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "code": {"type": "string", "minLength": 1, "maxLength": 160},
        "message": {"type": ["string", "null"], "maxLength": 2048}
      }
    },
    "outputs": {
      "type": "object",
      "propertyNames": {"pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["allocation_ref", "publication_state"],
        "properties": {
          "allocation_ref": {"type": "string", "minLength": 1, "maxLength": 1024},
          "publication_state": {"type": "string", "enum": ["UNWRITTEN", "STAGED", "FINALIZED", "FAILED", "ABANDONED"]},
          "artifact_id": {"type": ["string", "null"], "maxLength": 1024},
          "content_hash": {"type": ["string", "null"], "maxLength": 256},
          "size_bytes": {"type": ["integer", "null"], "minimum": 0}
        }
      }
    },
    "process": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "exit_code": {"type": ["integer", "null"]},
        "signal": {"type": ["integer", "null"], "minimum": 1},
        "runtime_id": {"type": ["string", "null"], "maxLength": 256}
      }
    },
    "resource_usage": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "wall_time_ms": {"type": ["integer", "null"], "minimum": 0},
        "cpu_time_ms": {"type": ["integer", "null"], "minimum": 0},
        "peak_memory_bytes": {"type": ["integer", "null"], "minimum": 0},
        "bytes_read": {"type": ["integer", "null"], "minimum": 0},
        "bytes_written": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "diagnostic": {"type": ["string", "null"], "maxLength": 4096}
  }
}
