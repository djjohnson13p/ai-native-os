{
  "profile": "aios-registry-phase1-v0.1",
  "description": "Synthetic lifecycle cases. Real contract/snapshot hashes are generated by the validator/registry implementation.",
  "cases": [
    {
      "name": "default-snapshot-switch-does-not-rewrite-old-task",
      "setup": {
        "task_old": {"task_id": "T-old", "registry_snapshot_id": "sha256:1111111111111111111111111111111111111111111111111111111111111111"},
        "default_before": "sha256:1111111111111111111111111111111111111111111111111111111111111111",
        "default_after": "sha256:2222222222222222222222222222222222222222222222222222222222222222"
      },
      "expected": {
        "task_old_registry_snapshot_unchanged": true,
        "new_task_default_snapshot": "sha256:2222222222222222222222222222222222222222222222222222222222222222"
      }
    },
    {
      "name": "provider-registration-cannot-redefine-semantic-contract",
      "setup": "provider manifest claims artifact.hash@1 but changes output port/type compared with resolved semantic contract",
      "expected": {
        "eligible": false,
        "reason_code": "PROVIDER_CONTRACT_INCOMPATIBLE"
      }
    },
    {
      "name": "two-provider-substitution-candidates-retain-one-semantic-contract",
      "setup": {
        "semantic_ref": "artifact.hash@1",
        "contract_hash": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "providers": ["provider:hash-rust", "provider:hash-wasm"]
      },
      "expected": {
        "semantic_contract_count": 1,
        "eligible_provider_count_before_policy_resource_filtering": 2,
        "semantic_program_hash_changes": false
      }
    },
    {
      "name": "provider-build-update-invalidates-new-build-conformance",
      "setup": {
        "old_build": "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
        "old_conformance_result": "pass",
        "new_build": "sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
      },
      "expected": {
        "new_build_inherits_old_result": false,
        "reason_code": "PROVIDER_CONFORMANCE_REQUIRED"
      }
    },
    {
      "name": "revoked-provider-not-eligible-despite-old-conformance-pass",
      "setup": {"provider_state": "REVOKED", "conformance_result": "pass"},
      "expected": {"eligible": false, "reason_code": "PROVIDER_REVOKED"}
    },
    {
      "name": "semantic-validation-never-loads-provider-code",
      "setup": "validate a program against an immutable semantic registry snapshot while provider registry is empty/unavailable",
      "expected": {
        "semantic_validation_possible": true,
        "provider_process_spawn_count": 0,
        "network_request_count": 0
      }
    },
    {
      "name": "conformance-does-not-grant-task-authority",
      "setup": {"provider_conformance": "pass", "task_policy": "deny artifact.read"},
      "expected": {
        "provider_selected_for_execution": false,
        "task_authority_granted": false
      }
    },
    {
      "name": "historical-snapshot-retained-after-revocation",
      "setup": "snapshot is revoked for new execution but referenced by retained completed Task provenance",
      "expected": {
        "eligible_for_new_task": false,
        "historical_contracts_still_resolvable": true
      }
    }
  ]
}
