{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-native-os.example/specs/provenance-verification-result.schema.json",
  "title": "AIOS Provenance Stream Verification Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "valid",
    "stream_id",
    "from_sequence",
    "to_sequence",
    "computed_head_hash",
    "verifier",
    "diagnostics",
    "verified_at"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1"},
    "valid": {"type": "boolean"},
    "stream_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^task:[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "from_sequence": {"type": "integer", "minimum": 1},
    "to_sequence": {"type": "integer", "minimum": 1},
    "expected_head_hash": {
      "type": ["string", "null"],
      "pattern": "^(?:sha256:[a-f0-9]{64})?$"
    },
    "computed_head_hash": {
      "type": ["string", "null"],
      "pattern": "^(?:sha256:[a-f0-9]{64})?$"
    },
    "checkpoint_id": {"type": ["string", "null"], "maxLength": 256},
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 160},
        "version": {"type": "string", "minLength": 1, "maxLength": 64},
        "build_hash": {"type": ["string", "null"], "maxLength": 256}
      }
    },
    "diagnostics": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "code", "message"],
        "properties": {
          "severity": {"type": "string", "enum": ["error", "warning"]},
          "code": {"type": "string", "pattern": "^PROVENANCE_[A-Z0-9_]+$"},
          "message": {"type": "string", "minLength": 1, "maxLength": 4096},
          "sequence": {"type": ["integer", "null"], "minimum": 1},
          "event_id": {"type": ["string", "null"], "maxLength": 256},
          "related": {
            "type": "array",
            "maxItems": 16,
            "items": {"type": "string", "maxLength": 1024}
          }
        }
      }
    },
    "diagnostics_truncated": {"type": "boolean", "default": false},
    "verified_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"valid": {"const": true}}, "required": ["valid"]},
      "then": {
        "properties": {
          "computed_head_hash": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        }
      }
    }
  ]
}
