{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-native-os.example/specs/view-contract.schema.json",
  "title": "AIOS View Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "view_id", "version", "object_types", "presentation_classes", "actions"],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1"},
    "view_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "object_types": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "presentation_classes": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "required_inputs": {
      "type": "array",
      "items": {"type": "string", "enum": ["keyboard", "pointer", "touch", "stylus", "voice", "camera", "gamepad", "switch_access"]},
      "uniqueItems": true
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action_id", "capability"],
        "properties": {
          "action_id": {"type": "string", "minLength": 1},
          "capability": {"type": "string", "minLength": 1},
          "privileged": {"type": "boolean"},
          "requires_trusted_system_approval_ui": {"type": "boolean"}
        }
      }
    },
    "streaming": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": {"type": "boolean"},
        "max_interactive_latency_ms": {"type": ["integer", "null"], "minimum": 1}
      }
    },
    "accessibility_alternatives": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "provider_requirement": {"type": ["string", "null"]}
  }
}
