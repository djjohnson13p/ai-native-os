{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-native-os.example/specs/provider-registration.schema.json",
  "title": "AIOS Provider Registration Record",
  "description": "Control-plane record produced after validating a provider package/manifest against semantic contracts, trust policy, and conformance evidence. It does not grant task authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registration_id",
    "provider",
    "package",
    "runtime",
    "capabilities",
    "trust",
    "state",
    "registered_at"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1"},
    "registration_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "minLength": 3, "maxLength": 256},
        "version": {"type": "string", "minLength": 1, "maxLength": 128},
        "manifest_hash": {"type": ["string", "null"], "maxLength": 256}
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_kind", "content_hash"],
      "properties": {
        "source_kind": {
          "type": "string",
          "enum": ["builtin", "local", "registry", "organization", "development", "legacy"]
        },
        "source_ref": {"type": ["string", "null"], "maxLength": 2048},
        "content_hash": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+:[A-Fa-f0-9]+$"
        },
        "publisher_id": {"type": ["string", "null"], "maxLength": 256},
        "signature_ref": {"type": ["string", "null"], "maxLength": 2048}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "minimum_isolation"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["builtin", "process", "varlink", "oci", "wasm", "model-adapter", "legacy-adapter", "remote"]
        },
        "minimum_isolation": {"type": "string", "enum": ["P0", "P1", "P2", "P3", "P4", "P5"]},
        "entrypoint_ref": {"type": ["string", "null"], "maxLength": 2048},
        "interface_ref": {"type": ["string", "null"], "maxLength": 1024}
      }
    },
    "registry_snapshot_id": {"type": ["string", "null"], "maxLength": 256},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "capability",
          "version",
          "contract_hash",
          "conformance_status",
          "eligible"
        ],
        "properties": {
          "capability": {"type": "string", "minLength": 3, "maxLength": 160},
          "version": {"type": "string", "minLength": 1, "maxLength": 64},
          "contract_hash": {
            "type": ["string", "null"],
            "pattern": "^(?:[a-z0-9_-]+:[A-Fa-f0-9]+)?$"
          },
          "conformance_suite": {"type": ["string", "null"], "maxLength": 512},
          "conformance_suite_hash": {"type": ["string", "null"], "maxLength": 256},
          "conformance_status": {
            "type": "string",
            "enum": ["declared", "tested", "certified", "failed", "not-required"]
          },
          "conformance_evidence_ref": {"type": ["string", "null"], "maxLength": 2048},
          "tested_at": {"type": ["string", "null"], "format": "date-time"},
          "eligible": {"type": "boolean"},
          "ineligibility_reasons": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "maxLength": 256}
          },
          "representations": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {"type": "string", "maxLength": 160},
              "uniqueItems": true
            }
          }
        }
      }
    },
    "trust": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["unverified", "locally-trusted", "project-reviewed", "organization-approved", "denied", "revoked"]
        },
        "decision_ref": {"type": ["string", "null"], "maxLength": 2048},
        "reviewed_at": {"type": ["string", "null"], "format": "date-time"},
        "revocation_ref": {"type": ["string", "null"], "maxLength": 2048}
      }
    },
    "state": {
      "type": "string",
      "enum": ["registered", "disabled", "revoked", "superseded", "invalid"]
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {"type": "string", "enum": ["unknown", "ready", "degraded", "unavailable", "blocked"]},
        "checked_at": {"type": ["string", "null"], "format": "date-time"},
        "reason_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "maxLength": 256}
        }
      }
    },
    "registered_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": ["string", "null"], "format": "date-time"}
  }
}
