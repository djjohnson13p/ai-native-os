{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-native-os.example/specs/artifact-output-allocation.schema.json",
  "title": "AIOS v0.1 Artifact Output Allocation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "allocation_id",
    "task_id",
    "semantic_program_hash",
    "node_id",
    "state",
    "sensitivity",
    "retention",
    "created_at",
    "expires_at"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1"},
    "allocation_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "semantic_program_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "node_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "binding_id": {"type": ["string", "null"], "maxLength": 256},
    "attempt_id": {"type": ["string", "null"], "maxLength": 256},
    "output_port": {"type": ["string", "null"], "maxLength": 128},
    "expected_semantic_type": {
      "type": ["string", "null"],
      "pattern": "^(?:[a-z][a-z0-9_.-]*@(?:0|[1-9][0-9]*))?$"
    },
    "allowed_media_types": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 160}
    },
    "max_size_bytes": {"type": ["integer", "null"], "minimum": 0},
    "sensitivity": {
      "type": "string",
      "enum": ["public", "local", "private", "confidential", "secret"]
    },
    "retention": {
      "type": "string",
      "enum": ["ephemeral", "task", "persistent", "user-managed"]
    },
    "state": {
      "type": "string",
      "enum": ["ALLOCATED", "WRITING", "FINALIZING", "PUBLISHED", "ABORTED", "EXPIRED", "FAILED"]
    },
    "publication_id": {"type": ["string", "null"], "maxLength": 256},
    "published_artifact_id": {"type": ["string", "null"], "maxLength": 512},
    "created_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": ["string", "null"], "format": "date-time"}
  }
}
