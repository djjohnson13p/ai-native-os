{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-native-os.example/specs/capability-token.schema.json",
  "title": "Capability Token",
  "type": "object",
  "additionalProperties": false,
  "required": ["token_id", "task_id", "principal", "grants", "issued_at", "expires_at"],
  "properties": {
    "token_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "principal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["agent", "provider", "legacy-app", "system-service", "user"]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "grants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability", "actions", "resources"],
        "properties": {
          "capability": {
            "type": "string",
            "minLength": 1
          },
          "actions": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"},
            "uniqueItems": true
          },
          "resources": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"},
            "uniqueItems": true
          },
          "constraints": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "approval": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "approval_id": {"type": ["string", "null"]},
        "actor": {"type": ["string", "null"]},
        "reason": {"type": ["string", "null"]}
      }
    },
    "delegation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "delegable": {"type": "boolean", "default": false},
        "max_depth": {"type": "integer", "minimum": 0, "default": 0}
      }
    },
    "nonce": {
      "type": ["string", "null"]
    }
  }
}
