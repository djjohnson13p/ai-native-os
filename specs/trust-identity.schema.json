{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-native-os.example/specs/trust-identity.schema.json",
  "title": "AIOS Trust Identity",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "identity_id", "kind", "trust_domain", "status", "key_version", "created_at", "updated_at"],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1"},
    "identity_id": {"type": "string", "minLength": 1, "maxLength": 512},
    "kind": {"type": "string", "enum": ["USER", "ORGANIZATION", "DEVICE", "SERVICE", "WORKLOAD", "PROVIDER", "PACKAGE_PUBLISHER", "PEER_FABRIC", "AUTOMATION_PRINCIPAL"]},
    "trust_domain": {"type": "string", "enum": ["LOCAL_DEVICE", "PERSONAL_FABRIC", "HOUSEHOLD_SHARED", "ORGANIZATION_MANAGED", "TRUSTED_PARTNER", "PUBLIC_REMOTE", "UNTRUSTED"]},
    "status": {"type": "string", "enum": ["PENDING", "ACTIVE", "ROTATING", "REVOKED", "EXPIRED", "RECOVERY_ONLY", "COMPROMISED"]},
    "key_version": {"type": "integer", "minimum": 1},
    "public_identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "algorithm": {"type": ["string", "null"], "maxLength": 128},
        "fingerprint": {"type": ["string", "null"], "maxLength": 512},
        "public_key_ref": {"type": ["string", "null"], "maxLength": 1024},
        "certificate_chain_ref": {"type": ["string", "null"], "maxLength": 1024}
      }
    },
    "owner": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "kind": {"type": "string", "enum": ["user", "organization", "system-service"]},
        "id": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "issuer_identity_id": {"type": ["string", "null"], "maxLength": 512},
    "attestation_refs": {"type": "array", "items": {"type": "string", "maxLength": 1024}, "uniqueItems": true},
    "allowed_roles": {"type": "array", "items": {"type": "string", "maxLength": 256}, "uniqueItems": true},
    "valid_from": {"type": ["string", "null"], "format": "date-time"},
    "valid_until": {"type": ["string", "null"], "format": "date-time"},
    "revocation": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "revoked_at": {"type": ["string", "null"], "format": "date-time"},
        "reason_code": {"type": ["string", "null"], "maxLength": 256},
        "replacement_identity_id": {"type": ["string", "null"], "maxLength": 512}
      }
    },
    "metadata": {"type": "object", "additionalProperties": true},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
