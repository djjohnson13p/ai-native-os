{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-native-os.example/specs/credential-use-result.schema.json",
  "title": "AIOS v0.1 Credential Use Result",
  "description": "Result of a mediated credential operation. Must never contain the source long-lived secret.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result_id",
    "request_id",
    "task_id",
    "credential_handle_id",
    "status",
    "reason_codes",
    "completed_at"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1"},
    "result_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "credential_handle_id": {"type": "string", "pattern": "^credential://", "maxLength": 1024},
    "status": {
      "type": "string",
      "enum": [
        "ALLOWED_AND_USED",
        "AUTHORITY_DENIED",
        "HANDLE_NOT_FOUND",
        "HANDLE_INACTIVE",
        "EXPIRED",
        "SCOPE_MISMATCH",
        "SERVICE_MISMATCH",
        "EXPORT_NOT_ALLOWED",
        "PROVIDER_BINDING_MISMATCH",
        "DELEGATION_FAILED",
        "SECURE_STORE_UNAVAILABLE",
        "EXTERNAL_AUTH_FAILED",
        "RATE_OR_USE_LIMIT",
        "CANCELLED",
        "OUTCOME_UNKNOWN"
      ]
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^CRED_[A-Z0-9_]+$", "maxLength": 128}
    },
    "effective_use_mode": {
      "type": ["string", "null"],
      "enum": [null, "BROKERED_OPERATION", "DELEGATED_SHORT_LIVED", "LOCAL_INJECTION_RESTRICTED", "EXPORT_WITH_APPROVAL"]
    },
    "delegated_credential": {
      "type": ["object", "null"],
      "description": "Metadata about an ephemeral delegated credential. Secret/token bytes are intentionally absent.",
      "additionalProperties": false,
      "properties": {
        "delegation_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "service_id": {"type": ["string", "null"], "maxLength": 512},
        "scopes": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "maxLength": 512}},
        "expires_at": {"type": "string", "format": "date-time"},
        "delivery_channel": {"type": "string", "enum": ["BROKER_HANDLE", "SEALED_FD", "EPHEMERAL_ENV", "EPHEMERAL_FILE", "PROTOCOL_AGENT", "REMOTE_BROKER_REFERENCE"]}
      }
    },
    "broker_operation": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "operation_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "service_id": {"type": ["string", "null"], "maxLength": 512},
        "semantic_result_ref": {"type": ["string", "null"], "maxLength": 1024}
      }
    },
    "secret_exposed_to_provider": {"type": "boolean", "default": false},
    "uses_consumed": {"type": "integer", "minimum": 0},
    "completed_at": {"type": "string", "format": "date-time"},
    "diagnostic": {"type": ["string", "null"], "maxLength": 2048}
  }
}
