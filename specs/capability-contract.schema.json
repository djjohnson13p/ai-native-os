{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-native-os.example/specs/capability-contract.schema.json",
  "title": "AI-Native OS Semantic Capability Contract",
  "description": "Provider-independent semantic operation contract with explicit required lower bounds and allowed upper bounds for effects and authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capability",
    "version",
    "inputs",
    "outputs",
    "allowed_execution_classes",
    "required_effect_classes",
    "allowed_effect_classes",
    "required_authority_classes",
    "allowed_authority_classes",
    "allowed_egress_modes",
    "error_classes",
    "conformance"
  ],
  "properties": {
    "capability": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160,
      "pattern": "^[a-z][a-z0-9_.-]+$"
    },
    "version": {
      "type": "string",
      "description": "Full semantic contract version. AIOS IR references this contract by semantic ID + major selector through an immutable registry snapshot.",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:\\.(?:0|[1-9][0-9]*))?$"
    },
    "description": {"type": "string", "maxLength": 4096},
    "role": {"type": "string", "enum": ["ordinary", "verifier"], "default": "ordinary"},
    "inputs": {
      "type": "object",
      "propertyNames": {"pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
      "additionalProperties": {"$ref": "#/$defs/port"}
    },
    "outputs": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
      "additionalProperties": {"$ref": "#/$defs/port"}
    },
    "allowed_execution_classes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "enum": ["deterministic", "bounded_nondeterministic", "probabilistic", "opaque_external"]}
    },
    "required_effect_classes": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/effectClass"},
      "description": "Effects inherent to every valid invocation. Empty means no non-optional effect lower bound; PURE is used when the capability is semantically always pure."
    },
    "allowed_effect_classes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/effectClass"},
      "description": "Maximum semantic effect envelope for any valid invocation/provider implementation."
    },
    "required_authority_classes": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/authorityClass"},
      "description": "Authority classes that every invocation must request explicitly in AIOS IR."
    },
    "allowed_authority_classes": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/authorityClass"},
      "description": "Maximum authority-class envelope a valid invocation/provider may require."
    },
    "allowed_egress_modes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "enum": ["deny", "policy"]}
    },
    "determinism": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "equivalence": {"type": "string", "enum": ["byte_identical", "canonical_value", "numeric_tolerance", "semantic", "not_applicable"]},
        "numeric_absolute_tolerance": {"type": ["number", "null"], "minimum": 0},
        "numeric_relative_tolerance": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "error_classes": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 3, "maxLength": 160, "pattern": "^[A-Z][A-Z0-9_]*$"}
    },
    "conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suite_id"],
      "properties": {
        "suite_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "suite_version": {"type": ["string", "null"], "maxLength": 64},
        "suite_hash": {"type": ["string", "null"], "maxLength": 256}
      }
    },
    "notes": {"type": "array", "items": {"type": "string", "maxLength": 2048}}
  },
  "$defs": {
    "effectClass": {
      "type": "string",
      "enum": ["PURE", "ARTIFACT_READ", "ARTIFACT_WRITE", "NETWORK", "DATA_EGRESS", "EXTERNAL_MESSAGE", "SECRET_ACCESS", "PERSISTENT_STATE", "DEVICE_ACCESS", "SYSTEM_CHANGE", "LEGACY_OPAQUE"]
    },
    "authorityClass": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_.:-]*$"
    },
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "required"],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 5,
          "maxLength": 128,
          "description": "Semantic type major selector, e.g. data.table@1.",
          "pattern": "^[a-z][a-z0-9_.-]*@(?:0|[1-9][0-9]*)$"
        },
        "required": {"type": "boolean"},
        "description": {"type": "string", "maxLength": 1024}
      }
    }
  }
}
