{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-native-os.example/specs/provenance-event.schema.json",
  "title": "Provenance Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "task_id", "event_type", "timestamp", "actor"],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1"},
    "event_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "step_id": {"type": ["string", "null"]},
    "event_type": {
      "type": "string",
      "enum": [
        "task.created",
        "task.paused",
        "task.resumed",
        "task.cancelled",
        "task.completed",
        "task.failed",
        "intent.normalized",
        "plan.created",
        "plan.revised",
        "ir.validation.started",
        "ir.validation.completed",
        "ir.validation.failed",
        "registry.snapshot.selected",
        "capability.resolved",
        "authorization.requested",
        "authorization.granted",
        "authorization.denied",
        "approval.requested",
        "approval.granted",
        "approval.denied",
        "provider.selected",
        "placement.selected",
        "execution.bound",
        "execution.started",
        "execution.completed",
        "execution.failed",
        "model.invoked",
        "model.completed",
        "egress.started",
        "egress.completed",
        "artifact.imported",
        "artifact.created",
        "artifact.verified",
        "artifact.integrity-failed",
        "verification.started",
        "verification.completed",
        "verification.failed",
        "rollback.started",
        "rollback.completed",
        "skill.proposed",
        "skill.created",
        "skill.validated",
        "skill.compiled",
        "skill.executed",
        "skill.invalidated"
      ]
    },
    "timestamp": {"type": "string", "format": "date-time"},
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["user", "agent", "provider", "model-provider", "system-service", "legacy-app", "policy-engine", "validator", "peer-node"]
        },
        "id": {"type": "string", "minLength": 1}
      }
    },
    "semantic_program_hash": {
      "type": ["string", "null"],
      "pattern": "^(?:[a-z0-9_-]+:[A-Fa-f0-9]+)?$"
    },
    "ir_version": {"type": ["string", "null"]},
    "registry_snapshot_id": {"type": ["string", "null"]},
    "validation_result_id": {"type": ["string", "null"]},
    "execution_binding_id": {"type": ["string", "null"]},
    "provider_id": {"type": ["string", "null"]},
    "provider_version": {"type": ["string", "null"]},
    "capability": {"type": ["string", "null"]},
    "capability_contract_hash": {
      "type": ["string", "null"],
      "pattern": "^(?:[a-z0-9_-]+:[A-Fa-f0-9]+)?$"
    },
    "authority_token_id": {"type": ["string", "null"]},
    "policy_decision_id": {"type": ["string", "null"]},
    "approval_id": {"type": ["string", "null"]},
    "skill": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "manifest_hash": {"type": ["string", "null"]},
        "compiled_target_id": {"type": ["string", "null"]}
      }
    },
    "input_artifacts": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "output_artifacts": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "external_transfer": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["destination", "data_refs"],
      "properties": {
        "destination": {"type": "string", "minLength": 1},
        "data_refs": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 1,
          "uniqueItems": true
        },
        "purpose": {"type": ["string", "null"]}
      }
    },
    "status": {
      "type": ["string", "null"],
      "enum": [null, "success", "failure", "denied", "partial", "pending", "cancelled"]
    },
    "details": {
      "type": "object",
      "description": "Diagnostic details only. Security-relevant identity should use dedicated typed fields above.",
      "additionalProperties": true
    },
    "previous_event_hash": {"type": ["string", "null"]},
    "event_hash": {"type": ["string", "null"]}
  }
}
