{
  "profile": "aios-ir-v0.1-edge-cases",
  "description": "Synthetic cases for ADR 0031/docs 68. Cases assume the bootstrap semantic registry plus any explicitly named test-only registry extension.",
  "cases": [
    {
      "name": "duplicate-authority-request-different-reason-is-invalid",
      "expected": "invalid",
      "validation_stage": "effects_authority",
      "reason_code": "IR_AUTHORITY_DUPLICATE_REQUEST",
      "program": {
        "ir_version": "0.1",
        "program_id": "edge.duplicate-authority",
        "kind": "task_graph",
        "inputs": {"source": {"type": "artifact.file@1"}},
        "nodes": [
          {
            "id": "copy",
            "operation": {"kind": "invoke", "capability": "artifact.copy@1"},
            "execution_class": "deterministic",
            "inputs": {"source": {"source": "input", "name": "source"}},
            "outputs": {"copy": "artifact.file@1"},
            "authority_requests": [
              {"action": "artifact.read", "resource": "input:source", "reason": "first"},
              {"action": "artifact.read", "resource": "input:source", "reason": "same semantic request, different prose"},
              {"action": "artifact.write", "resource": "task.output"}
            ],
            "egress": {"mode": "deny"},
            "failure": {"on_error": "stop"},
            "cache": "content_addressed"
          }
        ],
        "outputs": {"copy": {"source": "node", "node": "copy", "port": "copy"}}
      }
    },
    {
