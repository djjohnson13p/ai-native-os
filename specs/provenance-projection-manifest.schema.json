{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-native-os.example/specs/provenance-projection-manifest.schema.json",
  "title": "Privacy-Redacted Provenance Projection Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "export_profile", "projection_hash_profile", "bundle_id", "record_count", "head_sequence", "head_projection_hash", "descriptor_hash"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "export_profile": {"const": "privacy-redacted-projection-v1"},
    "projection_hash_profile": {"const": "aios-provenance-redacted-projection-v1"},
    "bundle_id": {"type": "string", "pattern": "^bundle:v1:[0-9a-f]{64}$"},
    "record_count": {"type": "integer", "minimum": 1, "maximum": 10000},
    "head_sequence": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "head_projection_hash": {"$ref": "#/$defs/hash"},
    "descriptor_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
