{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-native-os.example/specs/domain-pack.schema.json",
  "title": "AIOS Domain Pack Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "semantic_objects", "capabilities"],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]+$"},
    "version": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": ["string", "null"]},
    "semantic_objects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type_id", "version"],
        "properties": {
          "type_id": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "contract_ref": {"type": ["string", "null"]}
        }
      },
      "uniqueItems": true
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability_id", "version"],
        "properties": {
          "capability_id": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "contract_ref": {"type": ["string", "null"]},
          "conformance_suite": {"type": ["string", "null"]}
        }
      },
      "uniqueItems": true
    },
    "views": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "view_kind"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "view_kind": {"type": "string", "minLength": 1},
          "object_types": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "provider_requirement": {"type": ["string", "null"]}
        }
      }
    },
    "adapters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "enum": ["import", "export", "federation", "legacy-bridge", "remote"]},
          "formats_or_systems": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        }
      }
    },
    "policy_profiles": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "skills": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["domain_pack", "version_range"],
        "properties": {
          "domain_pack": {"type": "string", "minLength": 1},
          "version_range": {"type": "string", "minLength": 1}
        }
      }
    },
    "publisher": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "signature": {"type": ["string", "null"]},
        "source_url": {"type": ["string", "null"], "format": "uri"}
      }
    }
  }
}
