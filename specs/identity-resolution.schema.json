{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-native-os.example/specs/identity-resolution.schema.json",
  "title": "AIOS Identity Resolution Proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "resolution_id", "subject", "candidates", "status", "created_at"],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1"},
    "resolution_id": {"type": "string", "minLength": 1},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_system", "source_id", "semantic_type"],
      "properties": {
        "source_system": {"type": "string", "minLength": 1},
        "source_id": {"type": "string", "minLength": 1},
        "semantic_type": {"type": "string", "minLength": 1},
        "source_revision": {"type": ["string", "null"]}
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["object_id", "resolution_state", "evidence", "contradictions"],
        "properties": {
          "object_id": {"type": "string", "pattern": "^object://"},
          "resolution_state": {
            "type": "string",
            "enum": ["DISTINCT", "POSSIBLE_MATCH", "LIKELY_MATCH", "LINKED_EQUIVALENT", "MERGED", "SPLIT", "CONFLICTED"]
          },
          "score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["class", "source", "summary"],
              "properties": {
                "class": {
                  "type": "string",
                  "enum": ["AUTHORITATIVE_ID", "VERIFIED_IDENTIFIER", "STRONG_STRUCTURED_MATCH", "WEAK_STRUCTURED_MATCH", "GRAPH_CONTEXT", "SEMANTIC_SIMILARITY", "USER_ASSERTION", "PROVIDER_ASSERTION", "CONTRADICTION"]
                },
                "source": {"type": "string", "minLength": 1},
                "summary": {"type": "string", "minLength": 1},
                "observed_at": {"type": ["string", "null"], "format": "date-time"}
              }
            }
          },
          "contradictions": {
            "type": "array",
            "items": {"type": "string"},
            "uniqueItems": true
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": ["PROPOSED", "AWAITING_CONFIRMATION", "APPROVED_LINK", "APPROVED_MERGE", "REJECTED", "CONFLICTED", "EXPIRED"]
    },
    "consequence_level": {
      "type": "string",
      "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]
    },
    "policy_decision_id": {"type": ["string", "null"]},
    "approval_id": {"type": ["string", "null"]},
    "proposed_by": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "kind": {"type": "string", "enum": ["system-service", "provider", "model", "user"]},
        "id": {"type": "string", "minLength": 1}
      }
    },
    "created_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": ["string", "null"], "format": "date-time"}
  }
}
