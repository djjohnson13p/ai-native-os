{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-native-os.example/specs/capability-contract.schema.json",
  "title": "AI-Native OS Semantic Capability Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capability",
    "version",
    "inputs",
    "outputs",
    "allowed_execution_classes",
    "allowed_authority_classes",
    "allowed_egress_modes",
    "error_classes",
    "conformance"
  ],
  "properties": {
    "capability": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160,
      "pattern": "^[a-z][a-z0-9_.-]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$"
    },
    "description": {
      "type": "string",
      "maxLength": 4096
    },
    "role": {
      "type": "string",
      "enum": ["ordinary", "verifier"],
      "default": "ordinary"
    },
    "inputs": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/port"
      }
    },
    "outputs": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/port"
      }
    },
    "allowed_execution_classes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "deterministic",
          "bounded_nondeterministic",
          "probabilistic",
          "opaque_external"
        ]
      }
    },
    "allowed_effect_classes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "artifact_read",
          "artifact_write",
          "network",
          "external_message",
          "secret_access",
          "persistent_state",
          "device_access",
          "system_change",
          "none"
        ]
      }
    },
    "allowed_authority_classes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 128,
        "pattern": "^[a-z][a-z0-9_.:-]*$"
      }
    },
    "allowed_egress_modes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["deny", "policy"]
      }
    },
    "determinism": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "equivalence": {
          "type": "string",
          "enum": ["byte_identical", "canonical_value", "numeric_tolerance", "semantic", "not_applicable"]
        },
        "numeric_absolute_tolerance": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "numeric_relative_tolerance": {
          "type": ["number", "null"],
          "minimum": 0
        }
      }
    },
    "error_classes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 160,
        "pattern": "^[A-Z][A-Z0-9_]*$"
      }
    },
    "conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suite_id"],
      "properties": {
        "suite_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "suite_version": {
          "type": ["string", "null"],
          "maxLength": 64
        },
        "suite_hash": {
          "type": ["string", "null"],
          "maxLength": 256
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 2048
      }
    }
  },
  "$defs": {
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "required"],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9_.-]*(?:@[0-9]+(?:\\.[0-9]+)*)?$"
        },
        "required": {
          "type": "boolean"
        },
        "description": {
          "type": "string",
          "maxLength": 1024
        }
      }
    }
  }
}
